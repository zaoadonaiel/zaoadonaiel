---
import Layout from '../layouts/Layout.astro';
import heroData    from '../content/site/hero.json';
import aboutData   from '../content/site/about.json';
import beliefsData from '../content/site/beliefs.json';
import quoteData   from '../content/site/quote.json';
import locData     from '../content/site/locations.json';
import visitData   from '../content/site/visit.json';
import footerData  from '../content/site/footer.json';

const navLinks = [
  { href: '#hero',      label: 'Home' },
  { href: '#about',     label: 'About' },
  { href: '#beliefs',   label: 'What We Believe' },
  { href: '#locations', label: 'Locations' },
];

const heroTitle  = heroData.title.split('\n');
const visitTitle = visitData.title.split('\n');
---

<Layout>

  <!-- ══════════════════════════════════════════
       NAVBAR
  ══════════════════════════════════════════ -->
  <nav id="navbar">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo">
        <img src="/logo-white.png" alt="Zao Adona El" class="logo-mark">
      </a>

      <ul class="nav-links">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>

      <a href="#visit" class="btn-solid nav-cta">{heroData.cta_primary_label}</a>

      <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">✕</button>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href="#visit">{heroData.cta_primary_label}</a></li>
    </ul>
  </div>


  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section id="hero">
    <video class="hero-video" src="/hero-worship.mp4" autoplay muted loop playsinline aria-hidden="true"></video>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span>{heroData.eyebrow}</span>
      </div>

      <h1 class="hero-title">
        {heroTitle.map((line, i) => (
          <>{line}{i < heroTitle.length - 1 && <br />}</>
        ))}
      </h1>

      <p class="hero-sub">{heroData.subtitle}</p>

      <div class="hero-buttons">
        <a href={heroData.cta_secondary_href} class="btn-ghost">{heroData.cta_secondary_label}</a>
        <a href={heroData.cta_primary_href}   class="btn-solid">{heroData.cta_primary_label}</a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       MISSION STATEMENT
  ══════════════════════════════════════════ -->
  <section id="about">
    <div class="mission-inner">
      <p class="eyebrow-label">{aboutData.eyebrow}</p>
      <h2 class="mission-text">{aboutData.text}</h2>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHAT WE BELIEVE
  ══════════════════════════════════════════ -->
  <section id="beliefs">
    <div class="beliefs-inner">

      <div class="beliefs-header">
        <p class="eyebrow-label">{beliefsData.eyebrow}</p>
        <div class="beliefs-title-row">
          <h2 class="beliefs-title">{beliefsData.title.replace('\\n', '\n').split('\n').map((l, i, a) => <>{l}{i < a.length - 1 && <br />}</>)}</h2>
          <a href={beliefsData.link_href} class="beliefs-link">{beliefsData.link_label}</a>
        </div>
      </div>

      <div class="beliefs-list">
        {beliefsData.items.map((belief, i) => (
          <div class="belief-item reveal">
            <div class="belief-left">
              <span class="belief-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="belief-name">{belief.name}</h3>
            </div>
            <p class="belief-desc">{belief.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       SCRIPTURE QUOTE
  ══════════════════════════════════════════ -->
  <section id="quote">
    <div class="quote-inner">
      <blockquote class="quote-text reveal">"{quoteData.text}"</blockquote>
      <cite class="quote-ref reveal">{quoteData.reference}</cite>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       LOCATIONS
  ══════════════════════════════════════════ -->
  <section id="locations">
    <div class="locations-inner">

      <div class="locations-header">
        <p class="eyebrow-label">{locData.eyebrow}</p>
        <h2 class="locations-title">{locData.title}</h2>
      </div>

      <div class="locations-grid">
        {locData.items.map((location) => (
          <div class="location-card reveal">
            <div class="location-thumb">
              <img
                src={`${location.image}?auto=format&fit=crop&w=800&q=75`}
                alt={`${location.name} landscape`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="location-body">
              <h3 class="location-name">{location.name}</h3>
              <p class="location-desc">{location.desc}</p>
              <a href="#" class="location-link">Learn More →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       PLAN YOUR VISIT CTA
  ══════════════════════════════════════════ -->
  <section id="visit">
    <div class="visit-inner">
      <p class="eyebrow-label eyebrow-label--light">{visitData.eyebrow}</p>
      <h2 class="visit-title">
        {visitTitle.map((line, i) => (
          <>{line}{i < visitTitle.length - 1 && <br />}</>
        ))}
      </h2>
      <p class="visit-sub">{visitData.subtitle}</p>
      <div class="visit-buttons">
        <a href={visitData.cta_primary_href}   class="btn-solid">{visitData.cta_primary_label}</a>
        <a href={visitData.cta_secondary_href} class="btn-ghost">{visitData.cta_secondary_label}</a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       FOOTER
  ══════════════════════════════════════════ -->
  <footer>
    <div class="footer-inner">

      <div class="footer-brand">
        <div class="footer-logo">
          <img src="/logo-white.png" alt="Zao Adona El" class="logo-mark">
        </div>
        <p class="footer-tagline">{footerData.tagline}</p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <p class="footer-col-title">SITEMAP</p>
          <ul>
            <li><a href="#about">Home</a></li>
            <li><a href="#beliefs">About</a></li>
            <li><a href="#beliefs">What We Believe</a></li>
            <li><a href="#locations">Locations</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">CONTACT</p>
          <ul>
            <li><a href={`mailto:${footerData.contact_email}`}>{footerData.contact_email}</a></li>
            {locData.items.map((loc) => (
              <li><a href="#locations">{loc.name}</a></li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <p>{footerData.copyright} · Built with Astro</p>
    </div>
  </footer>

</Layout>
