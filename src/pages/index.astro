---
import Layout from '../layouts/Layout.astro';

const navLinks = [
  { href: '#hero',      label: 'Home' },
  { href: '#about',     label: 'About' },
  { href: '#beliefs',   label: 'What We Believe' },
  { href: '#locations', label: 'Locations' },
];

const beliefs = [
  {
    name: 'The Triune God',
    desc: 'One God eternally existing as Father, Son, and Holy Spirit — worshipped in unity and truth.',
  },
  {
    name: 'The Blood of Yeshua',
    desc: 'Redemption and new life through the shed blood of Yeshua the Messiah — our salvation.',
  },
  {
    name: 'The Word of God',
    desc: 'Scripture as the living, authoritative foundation of all we teach and practice.',
  },
  {
    name: 'The Living Church',
    desc: 'A people called to worship, community, and service — the place we gather.',
  },
];

const locations = [
  {
    slug: 'hawaii',
    image: 'https://images.unsplash.com/photo-1598135753163-6167c1a1ad65',
    name: 'Hawaii',
    desc: 'Island gatherings rooted in worship and the blood of Yeshua, serving local communities across three sites.',
  },
  {
    slug: 'arizona',
    image: 'https://images.unsplash.com/photo-1589046207215-b5ee3097bafc',
    name: 'Arizona',
    desc: "It doesn't take long to find the blood of Yeshua working in the desert Southwest — come see.",
  },
  {
    slug: 'california',
    image: 'https://images.unsplash.com/photo-1501594907352-04cda38ebc29',
    name: 'California',
    desc: 'A thriving community of believers growing in cities across the Golden State — neighbors serving neighbors.',
  },
  {
    slug: 'puerto-rico',
    image: 'https://images.unsplash.com/photo-1579687196544-08ae57ab5c11',
    name: 'Puerto Rico',
    desc: 'A Caribbean family of believers gathered under the blood of Yeshua — worshiping and serving across the island.',
  },
];
---

<Layout>

  <!-- ══════════════════════════════════════════
       NAVBAR
  ══════════════════════════════════════════ -->
  <nav id="navbar">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo">
        <img src="/logo-white.png" alt="Zao Adona El" class="logo-mark">
      </a>

      <ul class="nav-links">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>

      <a href="#visit" class="btn-solid nav-cta">Plan a Visit</a>

      <button class="nav-hamburger" id="nav-hamburger" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">✕</button>
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href="#visit">Plan a Visit</a></li>
    </ul>
  </div>


  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section id="hero">
    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span>ABOUT</span>
        <span class="eyebrow-dot">·</span>
        <span>BELIEFS</span>
        <span class="eyebrow-dot">·</span>
        <span>CALIFORNIA</span>
      </div>

      <h1 class="hero-title">
        THE<br>LIVING<br>CHURCH
      </h1>

      <p class="hero-sub">
        A congregation devoted to the triune God and the redeeming blood of Yeshua the Messiah.
      </p>

      <div class="hero-buttons">
        <a href="#beliefs" class="btn-ghost">What We Believe</a>
        <a href="#visit"   class="btn-solid">Plan a Visit</a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       MISSION STATEMENT
  ══════════════════════════════════════════ -->
  <section id="about">
    <div class="mission-inner">
      <p class="eyebrow-label">WHO WE ARE</p>
      <h2 class="mission-text">
        We are a people made alive in the Messiah — gathered to worship the living God, grow in His Word, and serve our communities across four locations.
      </h2>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       WHAT WE BELIEVE
  ══════════════════════════════════════════ -->
  <section id="beliefs">
    <div class="beliefs-inner">

      <div class="beliefs-header">
        <p class="eyebrow-label">FOUNDATIONS</p>
        <div class="beliefs-title-row">
          <h2 class="beliefs-title">What We<br>Believe</h2>
          <a href="#" class="beliefs-link">Read our full statement →</a>
        </div>
      </div>

      <div class="beliefs-list">
        {beliefs.map((belief, i) => (
          <div class="belief-item reveal">
            <div class="belief-left">
              <span class="belief-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="belief-name">{belief.name}</h3>
            </div>
            <p class="belief-desc">{belief.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       SCRIPTURE QUOTE
  ══════════════════════════════════════════ -->
  <section id="quote">
    <div class="quote-inner">
      <blockquote class="quote-text reveal">
        "In Him was life, and the life was the light of men."
      </blockquote>
      <cite class="quote-ref reveal">John 1:4</cite>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       LOCATIONS
  ══════════════════════════════════════════ -->
  <section id="locations">
    <div class="locations-inner">

      <div class="locations-header">
        <p class="eyebrow-label">FOUR LOCATIONS · ONE CHURCH</p>
        <h2 class="locations-title">Find Us Near You</h2>
      </div>

      <div class="locations-grid">
        {locations.map((location) => (
          <div class="location-card reveal">
            <div class="location-thumb">
              <img
                src={`${location.image}?auto=format&fit=crop&w=800&q=75`}
                alt={`${location.name} landscape`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="location-body">
              <h3 class="location-name">{location.name}</h3>
              <p class="location-desc">{location.desc}</p>
              <a href="#" class="location-link">Learn More →</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       PLAN YOUR VISIT CTA
  ══════════════════════════════════════════ -->
  <section id="visit">
    <div class="visit-inner">
      <p class="eyebrow-label eyebrow-label--light">YOU ARE WELCOME HERE</p>
      <h2 class="visit-title">PLAN YOUR<br>VISIT</h2>
      <p class="visit-sub">
        Whether you're exploring faith for the first time or looking for a church home, we'd love to meet you. Reach out and we'll help you find your nearest gathering.
      </p>
      <div class="visit-buttons">
        <a href="#locations" class="btn-solid">Get in Touch</a>
        <a href="#beliefs"   class="btn-ghost">Learn About Us</a>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════
       FOOTER
  ══════════════════════════════════════════ -->
  <footer>
    <div class="footer-inner">

      <div class="footer-brand">
        <div class="footer-logo">
          <img src="/logo-white.png" alt="Zao Adona El" class="logo-mark">
        </div>
        <p class="footer-tagline">
          A congregation devoted to the triune God and the redeeming blood of Yeshua the Messiah. Serving Hawaii, Arizona, California, and Puerto Rico.
        </p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <p class="footer-col-title">SITEMAP</p>
          <ul>
            <li><a href="#about">Home</a></li>
            <li><a href="#beliefs">About</a></li>
            <li><a href="#beliefs">What We Believe</a></li>
            <li><a href="#locations">Locations</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">CONTACT</p>
          <ul>
            <li><a href="mailto:hello@zaoadonael.org">hello@zaoadonael.org</a></li>
            <li><a href="#locations">Hawaii</a></li>
            <li><a href="#locations">Arizona</a></li>
            <li><a href="#locations">California</a></li>
            <li><a href="#locations">Puerto Rico</a></li>
          </ul>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© 2026 Zao Adona El. All rights reserved. · Built with Astro</p>
    </div>
  </footer>

</Layout>
